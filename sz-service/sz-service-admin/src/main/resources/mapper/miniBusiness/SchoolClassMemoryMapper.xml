<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sz.applet.miniBusiness.mapper.SchoolClassMemoryMapper">
    <!-- 通用映射 -->
    <resultMap id="BaseResultMap" type="com.sz.applet.miniBusiness.pojo.po.SchoolClassMemory">
        <id column="id" property="id"/>
        <result column="year" property="year"/>
        <result column="class_no" property="classNo"/>
        <result column="teacher_list" property="teacherList"/>
        <result column="student_list" property="studentList"/>
        <result column="images" property="images"/>
